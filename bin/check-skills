#!/usr/bin/env python3
"""Check every skills/<name>/SKILL.md against the repo rules.

Each skill keeps its version in SKILL.md frontmatter and its history in
skills/<name>/CHANGELOG.md, whose first entry must be that version. Page skills
carry a short "Where the page goes" pointer to reference/where-the-page-goes.md
at the plugin root. Any ../../ path, and any reference/*.md path (relative to
the skill's folder), that a SKILL.md names must exist, and a skill that uses
../../ or ${CLAUDE_PLUGIN_ROOT} paths must carry the "Needs the whole plugin" line.
Every python3/node script call goes through an unquoted ${CLAUDE_PLUGIN_ROOT}/<path>
and is covered by a one-script Bash rule in allowed-tools (plus the Read rule), except
the scripts in NEVER_PREAPPROVED, which keep prompting.

Usage: check-skills [skills_dir]   (default: skills/ at the repo root)
Exit 1 on any problem.
"""
import re
import shlex
import sys
from pathlib import Path

SEMVER = re.compile(r"^\d+\.\d+\.\d+$")
SCRIPT = re.compile(r"[\w./${}-]*scripts/(?:[\w.-]+/)*[\w.-]+\.(?:py|cjs|js|sh)")
INTERPRETER = re.compile(r"(?:python3|node)(?: -[\w-]+)* [\"']?$")
NAME = r"(?:([a-z][a-z0-9-]*):)?([a-z][a-z0-9-]*)"
REFS = [re.compile(r"`" + NAME + r"`\s+[Ss]kill\b"),
        re.compile(r"\b[Ss]kill\s+`" + NAME + r"`"),
        re.compile(r"(?<![\w/.:<-])/" + NAME + r"(?![\w/.:-])")]
BUILTIN = {"help", "clear", "compact", "init", "review", "model", "config", "loop", "schedule",
           "simplify", "login", "logout", "status", "memory", "agents", "hooks", "mcp", "plugin", "plugins"}
PAGE_SKILLS = {"design-review", "visual-qa", "pr-qa", "working-log", "questions", "qa-checklist", "article-copy-edit",
               "style-guide", "photo-picker", "todos", "review-cycle"}
PAGE_VALUES = ("artifact", "file", "wifi")
PAGE_REF = "../../reference/where-the-page-goes.md"
# A skill that reads ../../ paths says so, for anyone who copies one skill folder on its own.
WHOLE_PLUGIN = "**Needs the whole plugin.**"
ROOT = "${CLAUDE_PLUGIN_ROOT}"
READ_RULE = "Read(/${CLAUDE_PLUGIN_ROOT}/**)"
# Scripts whose arguments can run arbitrary commands or rewrite user files: never pre-approved.
NEVER_PREAPPROVED = {"shared/capture/with_server.py", "skills/todos/scripts/todos_apply.py",
                     "skills/todos/scripts/todos_adopt.py", "skills/pr-qa/scripts/install_session_hook.py",
                     "skills/pr-qa/scripts/pr_qa_collect.py"}
# A script call: interpreter, optional flags, optional quote, then the script path.
PLUGIN_CMD = re.compile(r"\b(python3|node)((?: -[\w-]+)*) ([\"']?)(\S+?\.(?:py|cjs|js|sh))\b")
FAKE_ROOT = "/opt/claude/plugins/cache/proofs/proofs/9.9.9"
ROOT_PATH = re.compile(r"\.\./\.\./[\w./-]*[\w-]|(?<![\w./-])reference/[\w./-]*\.md")


def frontmatter(text):
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not m:
        return None, text
    fm = {}
    for line in m.group(1).splitlines():
        k, sep, v = line.partition(":")
        if sep:
            fm[k.strip()] = v.strip().strip("\"'")
    return fm, text[m.end():]


def allowed_tools(text):
    """The allowed-tools entries from the frontmatter: YAML list items or a one-line value."""
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    if not m:
        return []
    lines = m.group(1).splitlines()
    for i, line in enumerate(lines):
        if re.match(r"allowed-tools\s*:", line):
            value = line.partition(":")[2].strip()
            if value:
                return _split_rules(value)
            out = []
            for item in lines[i + 1:]:
                im = re.match(r"\s+-\s+(.*\S)\s*$", item)
                if not im:
                    break
                out.append(im.group(1).strip("\"'"))
            return out
    return []


def _split_rules(value):
    """Split a one-line value on spaces or commas that sit outside parentheses."""
    out, cur, depth = [], "", 0
    for ch in value:
        depth += (ch == "(") - (ch == ")")
        if depth <= 0 and ch in " ,":
            if cur:
                out.append(cur)
            cur = ""
        else:
            cur += ch
    if cur:
        out.append(cur)
    return [r.strip("\"'") for r in out]


def rule_matches(rule, command):
    """Claude Code's Bash wildcard semantics: * matches any text; a trailing ' *' that is
    the only wildcard also matches the bare command."""
    m = re.fullmatch(r"Bash\((.*)\)", rule, re.S)
    if not m:
        return False
    pat = m.group(1)
    if pat.endswith(" *") and pat.count("*") == 1:
        rx = re.escape(pat[:-2]) + r"(?: .*)?"
    else:
        rx = ".*".join(re.escape(part) for part in pat.split("*"))
    return re.fullmatch(rx, command, re.S) is not None


def why_not_allowed(rules, command):
    """None when claude_code_allows would accept the command, else the reason, naming the token."""
    if "\n" in command or "\r" in command:
        return "a newline outside quotes makes two commands"
    quote, i = None, 0
    while i < len(command):
        ch, two = command[i], command[i:i + 2]
        if ch == "\\" and quote != "'":
            i += 2
            continue
        if quote is None and ch in "'\"":
            quote = ch
        elif ch == quote:
            quote = None
        elif quote != "'" and (ch == "`" or two == "$("):
            return "command substitution (%s) is not matched by an allow rule" % ("`" if ch == "`" else "$(")
        elif quote is None and ch == "#" and (i == 0 or command[i - 1].isspace()):
            return "an unquoted # starts a comment, which is not part of what the rule matched"
        elif quote is None and ch in "|;&<>()":
            return "unquoted %r is a shell operator, so Claude Code checks each part separately or asks" % ch
        i += 1
    if quote:
        return "unbalanced quote"
    try:
        lex = shlex.shlex(command, posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        tokens = list(lex)
    except ValueError as err:
        return "cannot tokenize: %s" % err
    if not tokens:
        return "empty command"
    if re.match(r"[A-Za-z_]\w*=", tokens[0]):
        return "leading %s sets a variable, so the command no longer starts with its program" % tokens[0]
    if tokens[0] == "cd":
        return "starts with cd, which Claude Code treats as a separate command"
    if not any(rule_matches(r, command) for r in rules):
        return "no allow rule matches"
    return None


def claude_code_allows(rules, command):
    """A deliberately strict model of Claude Code's Bash permission matching.

    False for any unquoted |, ;, &, &&, ||, >, <, (, ), backtick, $( or newline, for a
    leading NAME=value and for a command starting with cd; otherwise True only when some
    rule matches through rule_matches. Quoted text is one argument and is fine.

    Stricter than Claude Code on purpose: a command this accepts must be accepted by
    Claude Code, never the other way round. Never loosen it to make a skill pass; fix the
    skill's example instead."""
    return why_not_allowed(rules, command) is None


def check_plugin_calls(path, body, rules):
    """Rules for every python3/node script call and for the allowed-tools list."""
    errs = []
    repo = path.parent.parent.parent
    bash = [r for r in rules if r.startswith("Bash(")]
    for r in rules:
        if r == READ_RULE or re.fullmatch(r"Skill\(proofs:[a-z][a-z0-9-]*\)", r):
            continue
        m = re.fullmatch(r"Bash\((?:python3|node) " + re.escape(ROOT) + r"/([\w./-]+\.(?:py|cjs|js|sh)) \*\)", r)
        if not m or ".." in m.group(1):
            errs.append("allowed-tools rule %s is not allowed: only Bash(<python3|node> %s/<one script> *), %s and Skill(proofs:<name>)" % (r, ROOT, READ_RULE))
        elif m.group(1) in NEVER_PREAPPROVED or any(n in r for n in NEVER_PREAPPROVED):
            errs.append("allowed-tools rule %s must keep prompting (never pre-approve it)" % r)
    if rules and READ_RULE not in rules:
        errs.append("allowed-tools is missing %s" % READ_RULE)
    covering = [r.replace(ROOT, FAKE_ROOT) for r in bash]
    seen = set()
    for line in body.splitlines():
        for cm in PLUGIN_CMD.finditer(line):
            interp, flags, quote, target = cm.groups()
            if not target.startswith(ROOT + "/"):
                msg = "run plugin scripts through %s, not %s" % (ROOT, target)
            elif quote:
                msg = "%s call must be unquoted (the allow rule matches the command text)" % target
            else:
                rel = target[len(ROOT) + 1:]
                if not (repo / rel).exists():
                    msg = "path %s does not exist" % target
                elif rel in NEVER_PREAPPROVED:
                    continue
                else:
                    cmd = ("%s%s %s" % (interp, flags, target)).replace(ROOT, FAKE_ROOT)
                    if any(rule_matches(r, cmd) for r in covering):
                        continue
                    msg = "call to %s is not covered by allowed-tools" % target
            if msg not in seen:
                seen.add(msg)
                errs.append(msg)
    return errs


def page_section(body):
    """Text under '## Where the page goes' (headings inside code fences ignored), or None."""
    out, in_fence, active = [], False, False
    for line in body.splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            in_fence = not in_fence
        elif not in_fence and line.startswith("## "):
            if active:
                break
            active = line.strip() == "## Where the page goes"
            continue
        if active:
            out.append(line)
    return "\n".join(out).strip() if (active or out) else None


def check(path, names):
    errs = []
    fm, body = frontmatter(path.read_text())
    folder = path.parent.name
    if fm is None:
        return ["missing frontmatter"]
    if fm.get("name") != folder:
        errs.append("name %r does not match folder %r" % (fm.get("name"), folder))
    if not fm.get("description", "").startswith("Use when"):
        errs.append("description must start with 'Use when'")
    version = fm.get("version", "")
    if not SEMVER.match(version):
        errs.append("version %r is not semver" % version)
    if re.search(r"^## Changelog\s*$", body, re.M):
        errs.append("changelog belongs in CHANGELOG.md, not in SKILL.md")
    log = path.parent / "CHANGELOG.md"
    if not log.is_file():
        errs.append("missing CHANGELOG.md")
    else:
        entry = next((l for l in log.read_text().splitlines() if l.lstrip().startswith(("-", "*"))), "")
        if SEMVER.match(version) and not re.search(r"(?<![\w.])" + re.escape(version) + r"(?![\w.])", entry):
            errs.append("CHANGELOG.md first entry must be version %s" % version)
    if folder in PAGE_SKILLS:
        sec = page_section(body)
        if sec is None:
            errs.append("missing '## Where the page goes' section")
        elif PAGE_REF not in sec:
            errs.append("'Where the page goes' must point to %s" % PAGE_REF)
        else:
            ref = path.parent / PAGE_REF
            text = ref.read_text() if ref.is_file() else ""
            for v in PAGE_VALUES:
                if not re.search(r"\b" + v + r"\b", text):
                    errs.append("%s does not mention %s" % (PAGE_REF, v))
    if ("../../" in body or ROOT in body) and WHOLE_PLUGIN not in body:
        errs.append("uses ../../ or %s paths but lacks the %s line" % (ROOT, WHOLE_PLUGIN))
    errs.extend(check_plugin_calls(path, body, allowed_tools(path.read_text())))
    for rp in sorted(set(ROOT_PATH.findall(body))):
        if not (path.parent / rp).exists():
            errs.append("path %s does not exist" % rp)
    in_fence = False
    for n, line in enumerate(body.splitlines(), 1):
        fence = line.lstrip().startswith(("```", "~~~"))
        if fence:
            in_fence = not in_fence
        for sm in SCRIPT.finditer(line):
            if not INTERPRETER.search(line[:sm.start()]):
                errs.append("line %d: script %s must run through python3 or node" % (n, sm.group(0)))
        if in_fence or fence:
            continue
        for rx in REFS:
            for rm in rx.finditer(line):
                ns, name = rm.group(1), rm.group(2)
                if ns not in (None, "proofs") or (ns is None and rx is REFS[2] and name in BUILTIN):
                    continue
                if name not in names:
                    errs.append("line %d: references skill %r which does not exist" % (n, name))
    return errs


def main():
    root = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent / "skills"
    files = sorted(root.glob("*/SKILL.md")) if root.is_dir() else []
    if not files:
        print("check-skills: no skills found in %s" % root, file=sys.stderr)
        return 1
    names = {f.parent.name for f in files}
    bad = 0
    sections = {}
    for f in files:
        if f.parent.name in PAGE_SKILLS:
            sec = page_section(frontmatter(f.read_text())[1])
            if sec is not None:
                sections[f.parent.name] = sec
    if len(set(sections.values())) > 1:
        texts = list(sections.values())
        common = max(sorted(set(texts)), key=texts.count)
        for name in sorted(sections):
            if sections[name] != common:
                print("%s: 'Where the page goes' differs from the other page skills" % name)
                bad += 1
    for f in files:
        for e in check(f, names):
            print("%s: %s" % (f.parent.name, e))
            bad += 1
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
